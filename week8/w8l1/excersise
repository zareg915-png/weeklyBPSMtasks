assert round(aa_pro_ratio("MSRSLLLRFLLFLLLLPPLP", "L")) == round(50)
assert round(aa_pro_ratio("MSRSLLLRFLLFLLLLPPLP", "r")) == round(10)
assert round(aa_pro_ratio("MSRSLLLRFLLFLLLLPPLP", "Y")) == round(0)

