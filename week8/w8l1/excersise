#Q4 Using the lecture notes as a guide, write functions that will show the structure of a database table chosen by you, the user (i.e. one fuction might rely on the output from the other).

import os, MySQLdb
from contextlib import closing


def get_table_choice(cursor):
    cursor.execute("SHOW TABLES")
    tables = [row[0] for row in cursor.fetchall()]
    if not tables:
        print("No tables found in this database.")
        return None

    print("\nAvailable Tables:")
    print("-" * 30)
    for index, table_name in enumerate(tables, 1):
        print(f"[{index}] {table_name}")
    print("-" * 30)

    while True:
        try:
            choice = input(f"Pick a table number (1-{len(tables)}) or 'q' to quit: ").strip()
            if choice.lower() == "q":
                return None

            choice_num = int(choice)
            if 1 <= choice_num <= len(tables):
                return tables[choice_num - 1]
            else:
                print(f"Invalid number. Please choose between 1 and {len(tables)}.")
        except ValueError:
            print("Please enter a valid number or 'q'.")


def show_table_structure(cursor, table_name):
    cursor.execute(f"DESCRIBE {table_name}")
    columns = cursor.fetchall()
    print(f"\nStructure for table: '{table_name}'")
    print("~" * 60)
    print(f"{'Field Name':<20} | {'Type':<15} | {'Null Allowed?':<12} | {'Key'}")
    print("~" * 60)
    for col in columns:
        print(f"{col[0]:<20} | {col[1]:<15} | {col[2]:<13} | {col[3]}")
    print("-" * 60)


try:
    connection = MySQLdb.connect(
