#Q1 take two arguments (a protein sequence and an amino acid residue code) and returns the percentage of the protein that the amino acid makes up.
#defining function 
def aa_pro_ratio(pro_seq, aa):
    aa_len = pro_seq.upper().count(aa.upper())
    pro_len = len(pro_seq)
    percentage = (aa_len / pro_len)*100
    return percentage

#assertions
